[Unit]
Description=Gunicorn UbLegko
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/ublegko
EnvironmentFile=/var/www/ublegko/.env
ExecStart=/var/www/ublegko/.venv/bin/gunicorn \
    --workers 2 \
    --threads 2 \
    --timeout 60 \
    --bind 127.0.0.1:8000 \
    config.wsgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
