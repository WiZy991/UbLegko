# Скопируйте в /var/www/ublegko/.env и заполните значения.
# Не коммитьте реальный .env в git.

DJANGO_ENV=prod
DJANGO_SECRET_KEY=CHANGE_ME_TO_LONG_RANDOM_STRING
# Пока без домена — укажите IP сервера. Позже добавьте домен через запятую.
ALLOWED_HOSTS=YOUR_SERVER_IP
# Пока сайт открывается по HTTP (без HTTPS) — оставьте 0.
# После certbot / HTTPS поставьте 1.
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
# Для HTTPS раскомментируйте и укажите домен:
# CSRF_TRUSTED_ORIGINS=https://your-domain.ru,https://www.your-domain.ru

# Email заявок (пока можно оставить console)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.mail.ru
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=noreply@your-domain.ru
# ORDER_EMAIL_TO=pro-brite_uss@mail.ru
